{
  "expo": {
    "name": "Watch Now",
    "slug": "WatchNow",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "watchnow",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101412",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ermanojsharma.WatchNow",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101412",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "imageHeight": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.ermanojsharma.WatchNow"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5c3f403-9b06-44aa-9951-f719360f3670"
      }
    }
  }
}